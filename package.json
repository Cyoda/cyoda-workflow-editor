{
  "name": "cyoda-workflow-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Cyoda Workflow Editor monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyoda/cyoda-workflow-editor.git",
    "directory": "."
  },
  "homepage": "https://github.com/Cyoda/cyoda-workflow-editor#readme",
  "bugs": {
    "url": "https://github.com/Cyoda/cyoda-workflow-editor/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" run build",
    "test": "pnpm -r --filter=\"./packages/*\" --filter=\"./apps/*\" run test",
    "test:watch": "pnpm -r --filter=\"./packages/*\" run test:watch",
    "bench": "pnpm -r --filter=\"./packages/*\" run bench",
    "typecheck": "pnpm -r --filter=\"./packages/*\" --filter=\"./apps/*\" run typecheck",
    "lint": "eslint packages apps",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node ./scripts/release-publish.mjs",
    "release:preflight": "node ./scripts/release-preflight.mjs",
    "prerelease:enter": "changeset pre enter",
    "prerelease:exit": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19"
  }
}
